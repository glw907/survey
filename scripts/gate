#!/usr/bin/env bash
# The repo gate: every built file is current with tokens.json, and the theme passes contrast.
set -euo pipefail
cd "$(dirname "$0")/.."

node scripts/build --check

# cairn-audit reports theme-contrast findings at advisory tier and never sets its exit code, so
# the gate fails on any finding. audit/code-colors.css maps cairn's code roles onto Survey's
# --site-code-* colors, so the code pairs are measured too.
report=$(node_modules/.bin/cairn-audit --rule theme-contrast)
findings=$(grep ' advisory ' <<<"$report" || true)
if [ -n "$findings" ]; then
  echo "$findings" >&2
  exit 1
fi
echo "gate: ok"
